# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_telegram_user_id
SINK_CHAT_ID=-100xxxxxxxxxx

# Scraping & Retention Controls
# Maximum age of Telegram channel posts to collect upon discovery (default: 30 days)
MAX_AGE_DAYS=30
# Channel scraping interval in seconds (recommended 60-120s to prevent Telegram IP throttling)
SCRAPE_INTERVAL_SECONDS=90
# Database & Web retention window in days (default: 60 days / 2 months).
# Note: Expired jobs are removed from DB and Web Dashboard, but stay forever in Telegram!
EXPIRY_DAYS=60

# Web Server & Render Deployment
PORT=3000
NODE_ENV=production
# Render automatically supplies RENDER_EXTERNAL_URL; for local/VPS set BASE_URL
BASE_URL=http://localhost:3000

# Supabase Cloud Database (Optional but recommended for Render)
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role key for backend bots (or anon key)
SUPABASE_KEY=your_supabase_service_role_or_anon_key
