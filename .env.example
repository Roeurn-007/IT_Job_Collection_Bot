# ==============================================================================
# 🤖 TELEGRAM BOT CONFIGURATION (REQUIRED)
# ==============================================================================
# Telegram bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Telegram user chat ID (grants access to /admin, /setexpiry, /sink, etc.)
ADMIN_CHAT_ID=your_telegram_user_id
TELEGRAM_CHAT_ID=your_telegram_user_id

# Primary Destination Group / Channel ID where collected IT jobs are forwarded
SINK_CHAT_ID=-100xxxxxxxxxx

# ==============================================================================
# ⚙️ SCRAPER & RETENTION CONTROLS
# ==============================================================================
# Maximum age of posts to collect upon initial discovery (in days, default: 30)
MAX_AGE_DAYS=30

# Channel scraper loop interval in seconds (90s avoids Telegram IP rate-limits)
SCRAPE_INTERVAL_SECONDS=90

# Database & Web retention window in days (default: 60 days = 2 months)
# Note: Purged only from Database & Web Dashboard. Telegram messages stay 100% intact!
EXPIRY_DAYS=60

# ==============================================================================
# 🌐 WEB SERVER & RENDER DEPLOYMENT
# ==============================================================================
# Server port (Render automatically injects PORT; local defaults to 3000)
PORT=3000

# Environment mode
NODE_ENV=production

# Base URL of the application. On Render, Render sets RENDER_EXTERNAL_URL automatically.
# Set to your Render web service URL (e.g. https://it-job-collection-bot.onrender.com)
BASE_URL=http://localhost:3000

# ==============================================================================
# 🗄️ SUPABASE CLOUD DATABASE (OPTIONAL)
# ==============================================================================
# From Supabase Dashboard -> Project Settings -> API
# If left empty, the bot operates seamlessly using local storage (storage/collected.json)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
